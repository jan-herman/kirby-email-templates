{parameters
    string $lang = kirby()->language()?->code() ?? 'en',
    ?string $logo,
    string $siteTitle = site()->title()->toString(),
    string $siteUrl = site()->url(),
    string|callable $theme = 'default'
}

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="{$lang}">
<head>

    <title>{$siteTitle}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">

    <style data-no-inline>
        @media only screen and (max-width: 600px) {
            .inner-body {
                width: 100% !important;
            }

            .footer {
                width: 100% !important;
            }
        }

        @media only screen and (max-width: 500px) {
            .button {
                width: 100% !important;
            }
        }
    </style>

    {var $themeCss = call_user_func('email_templates_theme_css', $theme)}
    <style n:if="$themeCss">
        {$themeCss|noescape}
    </style>

    {block head}{/block}

</head>
<body>
    <table class="wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
        <tr>
            <td align="center">
                <table class="content" width="100%" cellpadding="0" cellspacing="0" role="presentation">

                    {* Email header *}
                    {block header}
                        {embed '@snippets/email/html/header', logo: $logo, url: $siteUrl}
                            {$siteTitle}
                        {/embed}
                    {/block}

                    {* Email body *}
                    <tr>
                        <td class="body" width="100%" cellpadding="0" cellspacing="0" style="border: hidden !important;">
                            <table class="inner-body" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
                                {* Body content *}
                                <tr>
                                    <td class="content-cell">
                                        {block content}{/block}
                                        {block subcopy}{/block}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {* Email footer *}
                    {block footer}
                        {embed '@snippets/email/html/footer'}
                            <p>
                                &copy; {date('Y')} {$siteTitle}. {_'email.allRightsReserved', fallback: 'All rights reserved.'}
                            </p>
                        {/embed}
                    {/block}

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
